# Dugble server/local development environment
# Copy this file to server/.env when running a Dugble process locally.

# Application
APP_ENV=development
HTTP_PORT=8080
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Datastore
# Required.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dugble?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Browser/API security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_DOMAIN=localhost
ENCRYPTION_KEYS=dug-v1:replace-with-base64-encoded-32-byte-key

# Request protection
# Required.
ARCJET_KEY=replace-with-your-arcjet-key

# Backoffice
BACKOFFICE_HTTP_PORT=8081
# Comma-separated authenticated users permitted to access the backoffice.
BACKOFFICE_ADMIN_EMAILS=admin@example.com

# AWS SES
# AWS_FROM_EMAIL and AWS_REGION are required.
AWS_FROM_EMAIL=hello@example.com
AWS_REGION=eu-north-1
# Optional when the AWS SDK can use its default credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Comma-separated SNS topic ARNs.
AWS_SNS_TOPIC_ARNS=

# NATS / queueing
NATS_URL=nats://localhost:4222

# SMS providers
MNOTIFY_API_KEY=
MOOLRE_VAS_KEY=

# New Relic
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_LOG_ENABLED=true

# Sentry
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ERROR_SAMPLE_RATE=1
SENTRY_DEBUG=false
