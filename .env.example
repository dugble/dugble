# Dugble Docker/deployment environment
# Copy this file to .env before running `make up` or Docker Compose.

# Application
APP_ENV=production
FRONTEND_URL=https://dugble.com
BACKEND_URL=https://api.dugble.com

# Public domains served by Caddy
API_DOMAIN=api.dugble.com
BACKOFFICE_DOMAIN=backoffice.dugble.com

# Browser/API security
CORS_ORIGINS=https://dugble.com
COOKIE_DOMAIN=dugble.com
TRUSTED_PROXY_CIDRS=172.16.0.0/12
ENCRYPTION_KEYS=dug-v1:replace-with-base64-encoded-32-byte-key
ARCJET_KEY=replace-with-your-arcjet-key

# Backoffice access
BACKOFFICE_ADMIN_EMAILS=admin@dugble.com

# PostgreSQL
POSTGRES_USER=dugble
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=dugble

# NATS
NATS_USER=dugble
NATS_PASSWORD=replace-with-a-strong-password

# AWS SES
AWS_FROM_EMAIL=hello@dugble.com
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_TOPIC_ARNS=arn:aws:sns:eu-north-1:123456789012:dugble-ses-events,arn:aws:sns:us-east-1:123456789012:dugble-ses-events

# SMS providers
MNOTIFY_API_KEY=
MOOLRE_VAS_KEY=

# Ghana payments
HUBTEL_ENABLED=false
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=

# Observability
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
NEW_RELIC_LOG_ENABLED=true
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ERROR_SAMPLE_RATE=1
SENTRY_DEBUG=false
